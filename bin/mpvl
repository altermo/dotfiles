#!/bin/sh
file='/home/user/projects/other/files/mpvl_list'
test ! -f $file&&echo "file $file not found"&&exit 1
act=$(grep "^$1\s" $file | cut -f2)
if test -z "$act";then
    echo "possible actions: $(cat $file | cut -f1 | tr '\n' ',')"
    test -n "$1"&&echo "unknown action: $1"
    exit 1
fi
mpv "$(eval "$act")" --no-video --shuffle
