#!/bin/sh

function nir_
{
  NIXPKGS_ALLOW_UNFREE=1 nix run nixpkgs#$1 --impure -- "${@:2}"
}

if ! test $1; then
  NIX_GET_COMPLETIONS=2 nix run nixpkgs# 2>/dev/null|cut -d# -f2|tr -d '\t'|sort \
    | fzf --preview 'NIXPKGS_ALLOW_UNFREE=1 nix eval nixpkgs#{} --impure --raw --apply '\''
      (x: builtins.concatStringsSep "\n\n" (map (y: builtins.getAttr y x.meta)
        (builtins.filter (y: builtins.hasAttr y x.meta)
          ["name" "description" "longDescription" "homepage"])))
      '\'' 2>/dev/null' \
    | xargs -r nir
else
  nir_ "$@"
fi
